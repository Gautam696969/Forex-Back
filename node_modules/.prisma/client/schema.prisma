datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("USER") // USER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account           Account?
  adminAuditLogs    AuditLog[] @relation("AdminLogs")
  targetedAuditLogs AuditLog[] @relation("TargetedLogs")
}

model Account {
  id            String   @id @default(uuid())
  userId        String   @unique
  accountNumber String   @unique
  balance       Float    @default(10000.0)
  equity        Float    @default(10000.0)
  usedMargin    Float    @default(0.0)
  freeMargin    Float    @default(10000.0)
  marginLevel   Float    @default(0.0)
  currency      String   @default("USD")
  leverage      Int      @default(100)
  isDemo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  positions    Position[]
  tradeHistory TradeHistory[]
  ledgers      AccountLedger[]
}

model CurrencyPair {
  id            String   @id @default(uuid())
  symbol        String   @unique // e.g. EUR/USD
  base          String // EUR
  quote         String // USD
  displayName   String // EUR / USD
  category      String   @default("MAJORS") // MAJORS, MINORS, CRYPTO, METALS
  digits        Int      @default(5)
  pipSize       Float    @default(0.0001)
  contractSize  Float    @default(100000)
  defaultSpread Float    @default(1.2) // in pips
  minLot        Float    @default(0.01)
  maxLot        Float    @default(100.0)
  lotStep       Float    @default(0.01)
  currentBid    Float
  currentAsk    Float
  change24h     Float    @default(0.0)
  high24h       Float    @default(0.0)
  low24h        Float    @default(0.0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id          String   @id @default(uuid())
  accountId   String
  symbol      String
  type        String // BUY, SELL, BUY_LIMIT, SELL_LIMIT, BUY_STOP, SELL_STOP
  status      String   @default("PENDING") // PENDING, FILLED, CANCELLED, REJECTED
  lots        Float
  targetPrice Float?
  stopLoss    Float?
  takeProfit  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Position {
  id             String    @id @default(uuid())
  accountId      String
  symbol         String
  type           String // BUY, SELL
  lots           Float
  entryPrice     Float
  currentPrice   Float
  stopLoss       Float?
  takeProfit     Float?
  requiredMargin Float     @default(0.0)
  unrealizedPnl  Float     @default(0.0)
  unrealizedPips Float     @default(0.0)
  swap           Float     @default(0.0)
  commission     Float     @default(0.0)
  status         String    @default("OPEN") // OPEN, CLOSED
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model TradeHistory {
  id           String   @id @default(uuid())
  accountId    String
  positionId   String
  symbol       String
  type         String // BUY, SELL
  lots         Float
  openPrice    Float
  closePrice   Float
  stopLoss     Float?
  takeProfit   Float?
  realizedPnl  Float
  realizedPips Float    @default(0.0)
  commission   Float    @default(0.0)
  swap         Float    @default(0.0)
  closeReason  String // MANUAL, TAKE_PROFIT, STOP_LOSS, STOP_OUT, ADMIN
  openedAt     DateTime
  closedAt     DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model AccountLedger {
  id            String   @id @default(uuid())
  accountId     String
  type          String // INITIAL_DEPOSIT, RESET_BALANCE, MANUAL_DEPOSIT, TRADE_PROFIT, TRADE_LOSS, ADMIN_ADJUSTMENT
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  note          String?
  createdAt     DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  adminId      String
  adminEmail   String
  action       String // RESET_BALANCE, ADJUST_BALANCE, CHANGE_PAIR_SPREAD, TOGGLE_PAIR, FORCE_CLOSE_POSITION
  targetUserId String?
  details      String
  reason       String
  createdAt    DateTime @default(now())

  admin      User  @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser User? @relation("TargetedLogs", fields: [targetUserId], references: [id], onDelete: SetNull)
}
